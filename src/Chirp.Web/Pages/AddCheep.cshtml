@page "/AddCheep"
@model Chirp.Web.Pages.AddCheepModel

<!DOCTYPE html>
<div>
    <form method="post">
        <p>Whats on your mind @Model.Author.Name? <br />
            <input type="hidden" asp-for="Author.Name" />
            <input type="text" size="80%" maxlength="160" asp-for="Cheep" id="Cheep" name="Cheep" required />
            <input type="submit" value="Cheep" />
        </p>
        @Html.AntiForgeryToken()
    </form>
</div>