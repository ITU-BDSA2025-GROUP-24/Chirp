@page "/{author}"
@model Chirp.Web.Pages.UserTimelineModel
@{
    ViewData["Title"] = "Chirp!";
    Layout = "Shared/_Layout";
    var routeName = HttpContext.GetRouteValue("author");
}

<div>
    @if (!Model.DoesUserExist)
    {
        <h2> User Not Found </h2>
        <p> The user <strong>@Model.AuthorName</strong> does not exist. </p>
        <p> <a href="/"> Return to public timeline </a> </p>
    }

    else
    {
        <h2> @routeName's Timeline </h2>
        @if (Model.Cheeps.Any())
        {
            <ul id="messagelist" class="cheeps">
                @foreach (var cheep in Model.Cheeps)
                {
                    <li>
                        <strong>
                            <a href="/@cheep.Author.Name">@cheep.Author.Name</a>
                        </strong>
                        @cheep.Cheep
                        <small>&mdash; @cheep.TimeStamp</small>
    
                        @if (User.Identity?.IsAuthenticated == true && User.Identity.Name == cheep.Author.Name)
                        {
                            <form method="post"
                                  action="/RemoveCheep"
                                  style="display:inline;">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="cheepId" value="@cheep.CheepId" />
                                <input type="hidden" name="returnUrl" value="/@(routeName)" />
                                <button type="submit" onclick="return confirm('Are you sure you want to delete this cheep?');"> Delete </button>
                            </form>
                        }
                    </li>
                }
            </ul>
        }
        else
        {
            <em>There are no cheeps so far.</em>
        }
    }
</div>
