@page "/"
@model Chirp.Web.Pages.PublicModel
@{
    ViewData["Title"] = "Chirp!";
    Layout = "Shared/_Layout";
}

<div>
    <h2> Public Timeline </h2>
    @if(User.Identity is not null && User.Identity.IsAuthenticated){
        
        <div class="cheepbox">
            <h3>What's on your mind @(User!.Identity!.Name)?</h3>
            <form class="share-cheep" method="post">
                <textarea type="text" asp-for="Message" required></textarea>
                <input type="submit" value="Share">
            </form>
        </div>
    }

    
    @if (Model.Cheeps.Any())
    {
        @if (User.Identity.IsAuthenticated)
        {
            <ul id="messagelist" class="cheeps">
                @foreach (var cheep in Model.Cheeps)
                {
                    <li>
                        <form method="post"
                              asp-page="/Public"
                              asp-page-handler="Follow"
                              asp-route-id="@cheep.Author.AuthorId"
                              asp-route-page="@Model.CurrentPage" action="/?handler=Follow&id=@cheep.Author.AuthorId&page=1">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="page" value="@Model.CurrentPage" />
                            <button type="submit" id="FollowBtn">
                                @(await Model.isFollowing(cheep.Author.AuthorId) ? "Unfollow" : "Follow")
                            </button>
                        </form>

                        <strong>
                            <a href="/@cheep.Author.Name">@cheep.Author.Name</a>
                        </strong>
                        @cheep.Cheep
                        <small>&mdash; @cheep.TimeStamp</small>
                    </li>

                }
            </ul>
        }
        else
        {
            <ul id="messagelist" class="cheeps">
                @foreach (var cheep in Model.Cheeps)
                {
                    <li>
                        <p>
                            <strong>
                                <a href="/@cheep.Author.Name">@cheep.Author.Name</a> <h6>@cheep.Author.AuthorId</h6>
                            </strong>
                            @cheep.Cheep
                            <small>&mdash; @cheep.TimeStamp</small>
                        </p>
                    </li>
                }
            </ul>
        }

        <nav class="pager" aria-label="Pagination" style="margin-top:1rem; display:flex; gap:.5rem; align-items:center;">
            <a href="/?page=@(Model.CurrentPage - 1)" class="btn">‹ Prev</a>

            <span>Page @Model.CurrentPage </span>

            <a href="/?page=@(Model.CurrentPage + 1)" class="btn">Next ›</a>
        </nav>
    }
    else
    {
        <em>There are no cheeps so far.</em>
    }
</div>
